{
  "name": "@chaitrabhairappa/react-rich-text-editor",
  "version": "1.5.0",
  "description": "A high-performance rich text editor for React (web) — matching the design and behavior of react-native-rich-text-editor",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --project tsconfig.build.json --module commonjs --outDir lib/commonjs",
    "build:esm": "tsc --project tsconfig.build.json --module esnext --outDir lib/module",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript",
    "typescript": "tsc --noEmit",
    "clean": "rm -rf lib",
    "example": "npm run build && cd example && npm install && npm run dev",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "react",
    "rich-text",
    "editor",
    "wysiwyg",
    "text-formatting",
    "contenteditable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chaitra9225/react-rich-text-editor.git"
  },
  "author": "Chaitra Bhairappa <chaithrachinnu.cbg@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Chaitra9225/react-rich-text-editor/issues"
  },
  "homepage": "https://github.com/Chaitra9225/react-rich-text-editor#readme",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
